# ---------------------------
# Environment Configuration
# ---------------------------

# === Hugging Face API ===
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2

# === Vector Database (choose one) ===
# Example for Pinecone
VECTOR_DB_PROVIDER=pinecone
VECTOR_DB_API_KEY=your_pinecone_api_key
VECTOR_DB_ENV=us-east1-gcp
VECTOR_DB_INDEX_NAME=legal-rag

# OR Example for Qdrant Cloud
# VECTOR_DB_PROVIDER=qdrant
# VECTOR_DB_API_URL=https://your-qdrant-instance.cloud.qdrant.io
# VECTOR_DB_API_KEY=your_qdrant_api_key
# VECTOR_DB_COLLECTION_NAME=legal_rag_docs

# === General App Settings ===
APP_NAME=Legal RAG App
APP_ENV=development
APP_PORT=8000

# === Optional ===
LOG_LEVEL=info
